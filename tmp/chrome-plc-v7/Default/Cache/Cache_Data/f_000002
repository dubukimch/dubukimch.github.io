/* Technical documentation */
.technical-page{background:#071019;color:var(--white)}
.doc-hero,.doc-section{width:min(calc(100% - 40px),var(--max));margin-inline:auto}
.doc-hero{min-height:92vh;padding:180px 0 100px;display:flex;flex-direction:column;justify-content:center}
.doc-hero h1{max-width:1050px;margin:0;font-size:clamp(3.5rem,7vw,7rem);line-height:.96;letter-spacing:-.075em}
.doc-hero h1 em{font-style:normal;color:transparent;background:linear-gradient(100deg,var(--cyan),var(--lime));-webkit-background-clip:text;background-clip:text}
.doc-hero>p:not(.kicker){max-width:760px;margin:30px 0 0;color:#aebcc6;font-size:1.12rem;line-height:1.8}
.doc-metrics{display:grid;grid-template-columns:repeat(3,1fr);max-width:760px;margin:55px 0 0;border-block:1px solid var(--line)}
.doc-metrics div{padding:22px 25px 22px 0}
.doc-metrics div+div{padding-left:25px;border-left:1px solid var(--line)}
.doc-metrics dt{color:var(--cyan);font-family:"Arial Narrow",sans-serif;font-size:1.7rem;font-weight:900}
.doc-metrics dd{margin:3px 0 0;color:var(--muted);font-size:.7rem;text-transform:uppercase;letter-spacing:.08em}
.doc-section{padding:125px 0;border-top:1px solid var(--line);scroll-margin-top:100px}
.doc-heading{max-width:900px;margin-bottom:55px}
.doc-project-intro{display:contents}
.doc-heading h2{margin:0 0 20px;font-size:clamp(2.8rem,6vw,5.7rem);line-height:1;letter-spacing:-.065em}
.doc-heading>p:last-child{max-width:760px;margin:0;color:var(--muted);font-size:1.04rem;line-height:1.8}
.doc-flow{display:grid;grid-template-columns:1fr 44px 1fr 44px 1fr;align-items:center}
.doc-flow article{min-height:245px;padding:28px;border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(145deg,rgba(255,255,255,.055),rgba(255,255,255,.018))}
.doc-flow article>span,.doc-grid article>span,.doc-scenario>span{color:var(--cyan);font-size:.64rem;font-weight:900;letter-spacing:.16em}
.doc-flow h3{margin:22px 0 12px;font-size:1.45rem}
.doc-flow p{margin:0;color:var(--muted);font-size:.9rem}
.doc-flow small{display:block;margin-top:25px;color:var(--lime);font-size:.7rem}
.doc-flow>i{display:grid;place-items:center;color:var(--cyan);font-style:normal}
.doc-steps{counter-reset:step;list-style:none;margin:65px 0 0;padding:0;border-top:1px solid var(--line)}
.doc-steps li{display:grid;grid-template-columns:190px 1fr;gap:35px;padding:24px 0;border-bottom:1px solid var(--line)}
.doc-steps b{font-size:.9rem}
.doc-steps p{margin:0;color:var(--muted);font-size:.9rem}
.doc-scenario{margin-top:42px;padding:28px;border:1px solid rgba(185,244,90,.25);border-radius:20px;background:rgba(185,244,90,.055)}
.doc-scenario strong{display:block;margin:12px 0 8px;color:var(--lime);font-size:1.2rem}
.doc-scenario p{margin:0;color:#aebcc6}
.doc-figure{margin:0 0 34px;overflow:hidden;border:1px solid rgba(99,230,242,.2);border-radius:24px;background:#050b11}
.doc-figure img{width:100%;aspect-ratio:16/7;object-fit:cover;object-position:top}
.doc-figure figcaption{display:flex;justify-content:space-between;gap:20px;padding:17px 22px;color:var(--muted);font-size:.75rem}
.doc-figure figcaption b{color:var(--lime);letter-spacing:.1em}
.doc-product-link{display:flex;justify-content:space-between;gap:30px;margin:-10px 0 34px;padding:18px 22px;border:1px solid rgba(185,244,90,.24);border-radius:15px;background:rgba(185,244,90,.055);color:var(--white)}
.doc-product-link b{color:var(--lime);font-size:.78rem;letter-spacing:.08em}
.doc-product-link span{color:#b9c5cc;font-size:.82rem;text-align:right}
.doc-grid{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}
.doc-grid article{min-height:250px;padding:30px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:rgba(12,24,36,.58)}
.doc-grid h3{margin:28px 0 12px;font-size:1.25rem}
.doc-grid p{margin:0;color:var(--muted);font-size:.9rem;line-height:1.8}
.doc-detail{display:grid;grid-template-columns:150px 1fr;gap:18px 35px;margin-top:34px;padding:30px;border-left:3px solid var(--cyan);background:var(--panel)}
.doc-detail h3{margin:0;color:var(--cyan);font-size:.88rem}
.doc-detail p,.doc-detail ol{margin:0;color:#aebcc6;font-size:.88rem;line-height:1.85}
.doc-detail ol{padding-left:19px}
.doc-reference{padding-bottom:150px}
.reference-table{border-top:1px solid var(--line)}
.reference-table div{display:grid;grid-template-columns:240px 1fr 1fr;gap:25px;padding:22px 0;border-bottom:1px solid var(--line);align-items:center}
.reference-table code{color:var(--cyan)}
.reference-table span{color:var(--muted);font-size:.82rem}
.doc-disclaimer{max-width:850px;margin:35px 0;color:var(--muted);font-size:.85rem;line-height:1.8}

@media(max-width:900px){
  .doc-hero{min-height:auto;padding-top:150px}
  .doc-flow{grid-template-columns:1fr}
  .doc-flow>i{padding:10px;rotate:90deg}
  .doc-flow article{min-height:0}
  .reference-table div{grid-template-columns:1fr;gap:5px}
}
@media(max-width:680px){
  .doc-hero,.doc-section{width:calc(100% - 28px)}
  .doc-hero{padding:130px 0 75px}
  .doc-hero h1{font-size:3.25rem}
  .doc-metrics{grid-template-columns:1fr}
  .doc-metrics div+div{padding-left:0;border-left:0;border-top:1px solid var(--line)}
  .doc-section{padding:85px 0}
  .doc-grid{grid-template-columns:1fr}
  .doc-grid article{min-height:0}
  .doc-steps li,.doc-detail{grid-template-columns:1fr;gap:10px}
  .doc-figure img{aspect-ratio:16/10}
  .doc-figure figcaption{display:block}
  .doc-figure figcaption span{display:block;margin-top:5px}
  .doc-product-link{display:block}
  .doc-product-link span{display:block;margin-top:7px;text-align:left}
}

@media print{
  @page{size:A4;margin:14mm}
  body{background:#fff!important;color:#17212b!important;font-size:10pt;-webkit-print-color-adjust:exact;print-color-adjust:exact}
  body::before,.technical-page .site-header,.technical-page .site-footer,.technical-page .actions,.technical-page .doc-product-link{display:none!important}
  .doc-hero,.doc-section{width:100%;max-width:none}
  .doc-hero{min-height:0;padding:8mm 0 18mm;page-break-after:always}
  .doc-hero h1{max-width:none;color:#071019;font-size:38pt;line-height:1.02}
  .doc-hero h1 em{color:#087d89;background:none;-webkit-text-fill-color:#087d89}
  .doc-hero>p:not(.kicker),.doc-heading>p:last-child,.doc-flow p,.doc-grid p,.doc-steps p,.doc-detail p,.doc-detail ol,.doc-disclaimer{color:#52616a!important}
  .doc-metrics{border-color:#ccd5d8}
  .doc-section{padding:8mm 0;border-top:1px solid #ccd5d8;page-break-before:auto}
  .doc-heading{margin-bottom:8mm;break-after:avoid}
  .doc-project-intro{display:block;break-inside:avoid}
  .doc-heading h2{color:#071019;font-size:30pt}
  .doc-flow{grid-template-columns:1fr 7mm 1fr 7mm 1fr}
  .doc-flow article{min-height:52mm;padding:6mm;border-color:#ccd5d8;background:#f3f7f7}
  .doc-flow h3{font-size:13pt}
  .doc-steps{margin-top:10mm;border-color:#ccd5d8}
  .doc-steps li{grid-template-columns:38mm 1fr;padding:4mm 0;border-color:#ccd5d8;break-inside:avoid}
  .doc-scenario{margin-top:3mm;padding:3mm 5mm;background:#f1f8e8;border-color:#b7d58a;break-inside:avoid}
  .doc-scenario strong{margin:2mm 0 1mm;font-size:10pt}
  .doc-scenario p{font-size:8.5pt;line-height:1.5}
  .doc-figure{margin-bottom:7mm;border-color:#ccd5d8;border-radius:3mm;break-inside:avoid}
  .doc-figure img{aspect-ratio:16/6}
  .doc-figure figcaption{padding:3mm 4mm;color:#52616a}
  .doc-grid{border-color:#ccd5d8}
  .doc-grid article{min-height:47mm;padding:6mm;border-color:#ccd5d8;background:#f7f9f8;break-inside:avoid}
  .doc-grid h3{margin:5mm 0 2mm;font-size:12pt;color:#071019}
  .doc-detail{padding:6mm;grid-template-columns:32mm 1fr;background:#f3f7f7;break-inside:avoid}
  .doc-reference{break-before:page}
  .reference-table div{grid-template-columns:42mm 1fr 1fr;border-color:#ccd5d8;break-inside:avoid}
  code{color:#087d89!important}
}

/* Product feature walkthroughs */
.project-guide-link{display:grid;grid-template-columns:190px 1fr auto;gap:25px;align-items:center;margin:22px 0 30px;padding:19px 22px;border:1px solid rgba(99,230,242,.22);border-radius:16px;background:linear-gradient(110deg,rgba(99,230,242,.07),rgba(185,244,90,.035));color:var(--white)}
.project-guide-link span{color:var(--cyan);font-size:.62rem;font-weight:900;letter-spacing:.14em}
.project-guide-link b{font-size:.92rem}
.project-guide-link i{color:var(--lime);font-size:.76rem;font-style:normal;white-space:nowrap}
.project-guide-link:hover,.project-guide-link:focus-visible{border-color:var(--cyan);transform:translateY(-2px)}
.product-page{--product-accent:var(--lime);background:#071019;color:var(--white)}
.product-page[data-product="gateway"]{--product-accent:var(--cyan)}
.product-page[data-product="twinforge"]{--product-accent:#7ee787}
.product-hero,.product-shell,.product-next{width:min(calc(100% - 40px),var(--max));margin-inline:auto}
.product-hero{min-height:88vh;padding:160px 0 90px;display:grid;grid-template-columns:minmax(0,.88fr) minmax(460px,1.12fr);gap:64px;align-items:center}
.product-crumbs{display:flex;align-items:center;gap:10px;margin-bottom:35px;color:var(--muted);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase}
.product-crumbs a{color:var(--product-accent)}
.product-hero h1{margin:0;font-size:clamp(3.9rem,7vw,7rem);line-height:.92;letter-spacing:-.075em}
.product-hero h1 em{display:block;color:var(--product-accent);font-style:normal}
.product-lead{max-width:680px;margin:28px 0 0;color:#aebcc6;font-size:1.08rem;line-height:1.85}
.product-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:34px}
.product-actions .button.primary{background:var(--product-accent)}
.product-proof{display:grid;grid-template-columns:repeat(3,1fr);margin:46px 0 0;border-block:1px solid var(--line)}
.product-proof div{padding:20px 18px 20px 0}
.product-proof div+div{padding-left:18px;border-left:1px solid var(--line)}
.product-proof dt{color:var(--product-accent);font-size:1.5rem;font-weight:900}
.product-proof dd{margin:5px 0 0;color:var(--muted);font-size:.68rem;line-height:1.45;text-transform:uppercase;letter-spacing:.08em}
.product-hero-visual{position:relative;margin:0;padding:11px;border:1px solid var(--line);border-radius:26px;background:rgba(255,255,255,.025);box-shadow:0 28px 80px rgba(0,0,0,.38)}
.product-hero-visual img{width:100%;aspect-ratio:16/9;object-fit:cover;object-position:top;border-radius:17px}
.product-hero-visual figcaption{display:flex;justify-content:space-between;gap:20px;padding:17px 7px 5px;color:var(--muted);font-size:.72rem}
.product-hero-visual figcaption b{color:var(--product-accent);letter-spacing:.1em}
.product-shell{display:grid;grid-template-columns:250px minmax(0,1fr);gap:70px;padding-bottom:120px}
.feature-nav{position:sticky;top:105px;align-self:start;padding:24px;border:1px solid var(--line);border-radius:20px;background:rgba(9,21,31,.9);backdrop-filter:blur(18px)}
.feature-nav>span{display:block;margin-bottom:17px;color:var(--product-accent);font-size:.65rem;font-weight:900;letter-spacing:.14em}
.feature-nav a{display:grid;grid-template-columns:25px 1fr;gap:10px;padding:12px 0;border-top:1px solid var(--line);color:#aebcc6;font-size:.78rem;line-height:1.35}
.feature-nav a b{color:var(--muted);font-size:.65rem}
.feature-nav a:hover,.feature-nav a:focus-visible{color:var(--white)}
.feature-nav footer{margin-top:18px;padding-top:18px;border-top:1px solid var(--line)}
.feature-nav footer a{display:block;padding:6px 0;border:0;color:var(--product-accent)}
.feature-content{min-width:0}
.feature-chapter{padding:105px 0;border-top:1px solid var(--line);scroll-margin-top:95px}
.feature-chapter:first-child{padding-top:0;border-top:0}
.feature-heading{display:grid;grid-template-columns:105px 1fr;gap:25px;align-items:start;margin-bottom:36px}
.feature-number{color:var(--product-accent);font-family:"Arial Narrow",sans-serif;font-size:3rem;font-weight:900;line-height:1}
.feature-heading .kicker{margin-bottom:10px}
.feature-heading h2{margin:0;font-size:clamp(2.35rem,4.5vw,4.5rem);line-height:1;letter-spacing:-.055em}
.feature-purpose{max-width:760px;margin:18px 0 0;color:#aebcc6;font-size:1rem;line-height:1.8}
.feature-shot{display:block;width:100%;padding:0;overflow:hidden;border:1px solid rgba(255,255,255,.14);border-radius:22px;background:#050b11;color:inherit;text-align:left;cursor:zoom-in;box-shadow:0 24px 60px rgba(0,0,0,.25)}
.feature-shot img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover;object-position:top}
.feature-shot>span{display:flex;justify-content:space-between;gap:20px;padding:17px 20px;color:var(--muted);font-size:.75rem}
.feature-shot>span b{color:var(--product-accent);letter-spacing:.1em}
.feature-explainer{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px;margin-top:18px}
.walk-card{min-width:0;padding:27px;border:1px solid var(--line);border-radius:18px;background:rgba(12,24,36,.7)}
.walk-card.wide{grid-column:1/-1}
.walk-card>span{display:block;color:var(--product-accent);font-size:.63rem;font-weight:900;letter-spacing:.15em}
.walk-card h3{margin:18px 0 12px;font-size:1.2rem}
.walk-card p{margin:0;color:var(--muted);font-size:.88rem;line-height:1.8}
.control-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:17px}
.control-tags span{padding:8px 11px;border:1px solid rgba(255,255,255,.13);border-radius:999px;background:rgba(255,255,255,.035);color:#c7d2da;font-family:ui-monospace,Consolas,monospace;font-size:.71rem}
.operator-steps{counter-reset:operator;list-style:none;margin:17px 0 0;padding:0}
.operator-steps li{counter-increment:operator;position:relative;padding:10px 0 10px 40px;border-top:1px solid var(--line);color:#b7c3cb;font-size:.84rem;line-height:1.65}
.operator-steps li::before{content:counter(operator,decimal-leading-zero);position:absolute;top:11px;left:0;color:var(--product-accent);font-family:ui-monospace,Consolas,monospace;font-size:.7rem;font-weight:800}
.behavior-flow{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;margin-top:18px}
.behavior-flow div{position:relative;padding:20px;border:1px solid var(--line);border-radius:14px;background:#08131d}
.behavior-flow div:not(:last-child)::after{content:"→";position:absolute;top:50%;right:-22px;color:var(--product-accent);transform:translateY(-50%)}
.behavior-flow b{display:block;margin-bottom:8px;color:var(--white);font-size:.82rem}
.behavior-flow span{color:var(--muted);font-size:.76rem;line-height:1.55}
.result-list{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin:17px 0 0;padding:0;list-style:none}
.result-list li{padding:13px 14px;border-left:2px solid var(--product-accent);background:rgba(255,255,255,.03);color:#b7c3cb;font-size:.8rem;line-height:1.55}
.result-list li::before{content:"CHECK ";color:var(--product-accent);font-family:ui-monospace,Consolas,monospace;font-size:.62rem;font-weight:900;letter-spacing:.08em}
.portfolio-value{margin-top:18px;padding:24px 27px;border:1px solid color-mix(in srgb,var(--product-accent) 35%,transparent);border-radius:18px;background:color-mix(in srgb,var(--product-accent) 6%,transparent)}
.portfolio-value b{display:block;margin-bottom:8px;color:var(--product-accent);font-size:.69rem;letter-spacing:.14em}
.portfolio-value p{margin:0;color:#cad4da;line-height:1.75}
.product-next{display:grid;grid-template-columns:1fr auto;gap:30px;align-items:center;margin-bottom:110px;padding:45px;border:1px solid var(--line);border-radius:25px;background:linear-gradient(135deg,rgba(99,230,242,.07),rgba(185,244,90,.05))}
.product-next h2{margin:0 0 8px;font-size:2rem}
.product-next p{margin:0;color:var(--muted)}
.product-next .actions{margin:0}

@media(max-width:1000px){
  .product-hero{grid-template-columns:1fr;padding-top:140px}
  .product-hero-copy{max-width:820px}
  .product-hero-visual{max-width:900px}
  .product-shell{grid-template-columns:1fr;gap:35px}
  .feature-nav{position:relative;top:auto;display:grid;grid-template-columns:repeat(3,1fr);gap:0 20px}
  .feature-nav>span,.feature-nav footer{grid-column:1/-1}
}
@media(max-width:680px){
  .project-guide-link{grid-template-columns:1fr;gap:8px}
  .product-hero,.product-shell,.product-next{width:calc(100% - 28px)}
  .product-hero{min-height:auto;padding:125px 0 75px;gap:38px}
  .product-hero h1{font-size:3.55rem}
  .product-proof{grid-template-columns:1fr}
  .product-proof div+div{padding-left:0;border-left:0;border-top:1px solid var(--line)}
  .product-hero-visual{padding:7px;border-radius:17px}
  .product-hero-visual figcaption{display:block}
  .feature-nav{grid-template-columns:1fr 1fr;padding:18px}
  .feature-chapter{padding:75px 0}
  .feature-heading{grid-template-columns:1fr;gap:10px}
  .feature-number{font-size:1.6rem}
  .feature-explainer{grid-template-columns:1fr}
  .walk-card.wide{grid-column:auto}
  .behavior-flow,.result-list{grid-template-columns:1fr}
  .behavior-flow div:not(:last-child)::after{content:"↓";top:auto;right:50%;bottom:-25px;transform:translateX(50%)}
  .feature-shot>span{display:block}
  .feature-shot>span small{display:block;margin-top:6px}
  .product-next{grid-template-columns:1fr;padding:28px}
}

@media print{
  .product-page{background:#fff!important;color:#17212b!important}
  .product-page .skip-link,.product-page .site-header,.product-page .site-footer,.product-page .feature-nav,.product-page .product-actions,.product-page .lightbox{display:none!important}
  .product-hero,.product-shell,.product-next{width:100%;max-width:none}
  .product-hero{min-height:0;padding:6mm 0 0;display:block;page-break-after:always}
  .product-crumbs{margin-bottom:5mm;font-size:7pt}
  .product-hero h1{color:#071019;font-size:34pt;line-height:.94}
  .product-lead{margin-top:5mm;font-size:9pt;line-height:1.55}
  .product-lead,.walk-card p,.product-next p{color:#52616a!important}
  .product-proof{margin-top:7mm}
  .product-proof div{padding:4mm 3mm}
  .product-proof div+div{padding-left:4mm}
  .product-proof dt{font-size:15pt}
  .product-proof dd{font-size:6.5pt}
  .product-hero-visual{margin-top:7mm;padding:0;border-color:#ccd5d8;box-shadow:none;break-inside:avoid}
  .product-hero-visual img{height:67mm;aspect-ratio:auto;object-fit:cover;object-position:top}
  .product-hero-visual figcaption{padding:2.5mm 3mm;font-size:6.5pt}
  .product-proof{border-color:#ccd5d8}
  .product-shell{display:block;padding:0}
  .feature-chapter{padding:5mm 0;border-color:#ccd5d8;break-before:page}
  .feature-chapter:first-child{break-before:auto}
  .feature-heading{grid-template-columns:20mm 1fr;gap:4mm;margin-bottom:5mm;break-inside:avoid}
  .feature-number{font-size:25pt}
  .feature-heading .kicker{margin-bottom:2mm;font-size:6.5pt}
  .feature-heading h2{color:#071019;font-size:24pt}
  .feature-purpose{margin-top:3mm;font-size:8.5pt;line-height:1.55}
  .feature-shot{border-color:#ccd5d8;box-shadow:none;break-inside:avoid}
  .feature-shot>span{padding:3mm 4mm;color:#52616a;font-size:6.5pt}
  .feature-explainer{display:flex;flex-wrap:wrap;gap:3mm;margin-top:0;break-before:page;break-after:avoid-page}
  .walk-card{padding:5mm;border-color:#ccd5d8;background:#f5f8f8;break-inside:avoid}
  .walk-card:not(.wide){flex:0 0 calc(50% - 1.5mm);width:calc(50% - 1.5mm);max-width:calc(50% - 1.5mm)}
  .walk-card.wide{flex:0 0 100%;width:100%;max-width:100%}
  .walk-card>span{font-size:6.3pt}
  .walk-card h3{margin:3mm 0 2mm;font-size:11.5pt}
  .walk-card p{font-size:8.4pt;line-height:1.55}
  .control-tags{gap:1.5mm;margin-top:3mm}
  .control-tags span{padding:1.6mm 2.2mm;font-size:6.4pt}
  .operator-steps{margin-top:3mm}
  .operator-steps li{padding:2mm 0 2mm 9mm;font-size:8pt;line-height:1.45;overflow-wrap:normal;word-break:keep-all}
  .operator-steps li::before{top:2.2mm;font-size:6pt}
  .control-tags span,.behavior-flow div{border-color:#ccd5d8;background:#fff;color:#52616a}
  .operator-steps li,.result-list li{color:#52616a;border-color:#d7dfe2}
  .behavior-flow{gap:5mm;margin-top:3mm}
  .behavior-flow div{padding:3mm}
  .behavior-flow div:not(:last-child)::after{right:-4mm}
  .behavior-flow b{margin-bottom:1.5mm;color:#17212b!important;font-size:8pt}
  .behavior-flow span{font-size:7.5pt;line-height:1.45}
  .result-list{gap:2mm;margin-top:3mm}
  .result-list li{padding:2.5mm 3mm;font-size:7.6pt;line-height:1.45}
  .portfolio-value{margin-top:3mm;padding:4mm 5mm;break-inside:avoid;break-before:avoid-page}
  .portfolio-value b{margin-bottom:1.5mm;font-size:6pt}
  .portfolio-value p{color:#52616a!important;font-size:8.2pt;line-height:1.5}
  .product-next{display:none}
}
